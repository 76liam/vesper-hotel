<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#6c1d31">
<meta name="format-detection" content="telephone=no">
<title>VESPER — Private Night Resort</title>
<style>
@font-face{font-family:'Paganini';src:url('./fonts/paganini-regular.otf') format('opentype');font-style:normal;font-weight:400;font-display:block}
@font-face{font-family:'SUIT';src:url('./fonts/SUIT-Medium.otf') format('opentype');font-style:normal;font-weight:500;font-display:block}
:root{--burgundy:#6c1d31;--wine:#351019;--deep:#11080b;--ivory:#f4efe7;--paper:#eee7dd;--gold:#b89a63;--muted:#c9beb2;--line:rgba(255,255,255,.2)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:78px}body{margin:0;background:var(--deep);color:var(--ivory);font-family:'SUIT',sans-serif;-webkit-font-smoothing:antialiased}body.menu-open{overflow:hidden}.site{overflow:hidden}img{max-width:100%;display:block}a{color:inherit}.nav{position:fixed;z-index:100;top:0;left:0;right:0;height:78px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;color:#fff;transition:background .35s,backdrop-filter .35s}.nav.scrolled{background:rgba(17,8,11,.88);backdrop-filter:blur(16px)}.nav-brand{width:108px;display:block}.nav-brand img{width:100%;filter:brightness(0) invert(1)}.nav-links{display:flex;gap:32px;font:400 12px 'Paganini',Georgia,serif;letter-spacing:.12em;text-transform:uppercase}.nav-links a{text-decoration:none}.nav-menu{display:none;background:transparent;border:0;color:#fff;font:400 11px 'Paganini',Georgia,serif;letter-spacing:.16em;padding:12px 0;cursor:pointer}.menu-panel{position:fixed;inset:0;background:var(--burgundy);z-index:90;display:flex;flex-direction:column;justify-content:space-between;padding:105px 7vw 42px;opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity .3s,transform .3s,visibility .3s}.menu-panel.open{opacity:1;visibility:visible;transform:none}.menu-close{position:absolute;right:6vw;top:23px;background:transparent;border:0;color:#fff;font:400 11px 'Paganini',Georgia,serif;letter-spacing:.16em;cursor:pointer}.mobile-links{display:flex;flex-direction:column;gap:19px}.mobile-links a{font:400 clamp(40px,12vw,64px)/1 'Paganini',Georgia,serif;text-decoration:none;letter-spacing:.01em}.mobile-menu-footer{font:400 10px 'Paganini',Georgia,serif;letter-spacing:.16em;color:#e5d8ca}
.hero{min-height:100svh;display:grid;place-items:center;position:relative;background:radial-gradient(circle at 50% 30%,#7a293d,#4b1524 32%,#210c14 60%,#10080a 84%);isolation:isolate}.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.43),transparent 45%,rgba(0,0,0,.5)),radial-gradient(circle at 50% 100%,transparent 25%,rgba(0,0,0,.62));z-index:-1}.hero:after{content:"";position:absolute;width:70vw;height:70vw;border:1px solid rgba(239,221,203,.13);border-radius:50%;top:50%;left:50%;transform:translate(-50%,-43%);z-index:-1}.hero-content{text-align:center;padding:110px 22px 70px}.eyebrow{font:400 11px 'Paganini',Georgia,serif;letter-spacing:.3em;color:#dec38b;margin-bottom:28px}.hero-logo{width:min(61vw,430px);margin:auto;filter:brightness(0) invert(1)}.tag{font:400 13px 'Paganini',Georgia,serif;letter-spacing:.27em;margin-top:23px}.cta{display:inline-flex;align-items:center;justify-content:center;min-height:50px;margin-top:50px;padding:0 28px;border:1px solid rgba(216,187,143,.75);text-decoration:none;font:400 11px 'Paganini',Georgia,serif;letter-spacing:.2em}
section{padding:130px 9vw}.intro{background:var(--ivory);color:#241517;display:grid;grid-template-columns:1fr 1.45fr;gap:10vw;align-items:center}.kicker{font:400 11px 'Paganini',Georgia,serif;letter-spacing:.25em;color:var(--burgundy)}h2{font:400 clamp(42px,5vw,72px)/1.04 'Paganini',Georgia,serif;margin:20px 0}.intro p{font-size:17px;line-height:2;max-width:650px;margin:0}.hotel-image{background:#160a0e;color:#fff;display:grid;grid-template-columns:1.25fr .75fr;padding:0}.media{position:relative;overflow:hidden}.media img{width:100%;height:100%;object-fit:cover}.hotel-image .media{min-height:650px}.hotel-copy{padding:80px 8vw;display:flex;flex-direction:column;justify-content:center}.hotel-copy p{font-size:15px;line-height:1.9;color:var(--muted);margin:0}.image-caption{margin-top:20px;font:400 10px 'Paganini',Georgia,serif;letter-spacing:.14em;color:var(--gold)}
.night{background:var(--wine);text-align:center}.night h2{color:#f5eee7}.stats{display:grid;grid-template-columns:repeat(3,1fr);max-width:900px;margin:68px auto 0;border-top:1px solid var(--line)}.stat{padding:34px 15px;border-right:1px solid var(--line)}.stat:last-child{border:0}.num{font:400 clamp(35px,4vw,48px) 'Paganini',Georgia,serif;color:var(--gold)}.label{font:400 10px 'Paganini',Georgia,serif;letter-spacing:.17em;margin-top:12px;color:var(--muted)}
.facilities{background:#170b0f}.facility-head{display:flex;justify-content:space-between;gap:40px;align-items:end}.facility-head p{max-width:440px;color:var(--muted);font-size:14px;line-height:1.9;margin:0}.facility-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:60px}.facility{position:relative;min-height:420px;overflow:hidden;background:#241014}.facility:nth-child(3){grid-column:span 2;min-height:520px}.facility img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}.facility:hover img{transform:scale(1.035)}.facility:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(0,0,0,.78));pointer-events:none}.facility-placeholder{height:100%;min-height:420px;display:flex;align-items:flex-end;padding:28px;background:radial-gradient(circle at 60% 20%,#82515e,#34131d 45%,#10090c)}.facility-info{position:absolute;z-index:2;left:28px;right:28px;bottom:25px;color:#fff}.facility-no{font:400 10px 'Paganini',Georgia,serif;letter-spacing:.2em;color:#ddc48e}.facility h3{font:400 30px 'Paganini',Georgia,serif;margin:7px 0 0}.facility p{font-size:12px;line-height:1.6;margin:8px 0 0;color:#e4dbd2}
.rooms{background:var(--paper);color:#241517}.room-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:55px}.room{min-height:500px;position:relative;overflow:hidden;background:#251416}.room img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.room:hover img{transform:scale(1.035)}.room:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(0,0,0,.78));pointer-events:none}.room-info{position:absolute;z-index:2;left:28px;right:28px;bottom:26px;color:#fff}.room span{font:400 10px 'Paganini',Georgia,serif;letter-spacing:.2em;color:#e7d7bd}.room h3{font:400 29px 'Paganini',Georgia,serif;margin:8px 0 0}.room-link{display:inline-block;margin-top:17px;font:400 10px 'Paganini',Georgia,serif;letter-spacing:.16em;text-decoration:none;border-bottom:1px solid #fff;padding-bottom:5px}
.reserve{background:#14090d;display:grid;grid-template-columns:1fr 1fr;gap:10vw;align-items:center}.reserve p{font-size:15px;line-height:1.9;color:var(--muted);max-width:530px}.reserve-box{border:1px solid rgba(184,154,99,.4);padding:40px}.reserve-box small{font:400 10px 'Paganini',Georgia,serif;letter-spacing:.2em;color:var(--gold)}.reserve-box strong{display:block;font:400 28px 'Paganini',Georgia,serif;margin:14px 0 22px}.reserve-box a{display:inline-flex;border:1px solid #a88a63;padding:14px 23px;text-decoration:none;font:400 10px 'Paganini',Georgia,serif;letter-spacing:.18em}footer{padding:55px 9vw;background:#0c0708;color:#a99d91;display:flex;justify-content:space-between;font:400 10px 'Paganini',Georgia,serif;letter-spacing:.18em}.reveal{opacity:0;transform:translateY(24px);transition:.8s ease}.reveal.visible{opacity:1;transform:none}
@media(max-width:700px){html{scroll-padding-top:68px}.nav{height:68px;padding:0 6vw}.nav-brand{width:91px}.nav-links{display:none}.nav-menu{display:block}.hero-content{padding:90px 20px 65px}.hero-logo{width:min(78vw,330px)}.eyebrow{font-size:9px;letter-spacing:.22em}.tag{font-size:10px;letter-spacing:.17em}.cta{margin-top:42px;min-height:48px;font-size:10px}.hero:after{width:118vw;height:118vw}.intro{display:block;padding-bottom:88px}.intro h2{font-size:49px}.intro p{font-size:14px;line-height:1.95}.hotel-image{display:flex;flex-direction:column;padding:0}.hotel-image .media{min-height:420px}.hotel-copy{padding:60px 7vw}.hotel-copy h2{font-size:48px}.night{padding:94px 7vw}.night h2{font-size:43px}.stats{grid-template-columns:1fr;margin-top:48px}.stat{padding:25px 10px;border-right:0;border-bottom:1px solid var(--line)}.stat:last-child{border-bottom:0}.facilities{padding:88px 7vw}.facility-head{display:block}.facility-head p{margin-top:22px;font-size:13px}.facility-grid{grid-template-columns:1fr;gap:12px;margin-top:38px}.facility,.facility:nth-child(3){grid-column:auto;min-height:320px}.facility:nth-child(3){min-height:400px}.facility-placeholder{min-height:320px}.facility-info{left:22px;right:22px;bottom:20px}.facility h3{font-size:27px}.facility p{font-size:11px}.rooms{padding:88px 7vw}.rooms h2{font-size:48px}.room-grid{grid-template-columns:1fr;gap:12px;margin-top:40px}.room{min-height:390px}.room-info{left:23px;right:23px;bottom:22px}.room h3{font-size:27px}.reserve{grid-template-columns:1fr;gap:42px}.reserve h2{font-size:48px}.reserve p{font-size:14px}.reserve-box{padding:28px}footer{display:block;padding:45px 7vw;line-height:2.5}footer div+div{margin-top:8px}}
</style>
</head>
<body>
<div class="site">
<nav class="nav" id="nav"><a class="nav-brand" href="#top" aria-label="VESPER home"><img src="./logo/vesper-logo.png" alt="VESPER"></a><div class="nav-links"><a href="#hotel">Hotel</a><a href="#facilities">Facilities</a><a href="#rooms">Rooms</a><a href="#reserve">Reserve</a></div><button class="nav-menu" id="menuOpen" type="button" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false">MENU</button></nav>
<div class="menu-panel" id="mobileMenu" aria-hidden="true"><button class="menu-close" id="menuClose" type="button" aria-label="Close menu">CLOSE</button><div class="mobile-links"><a href="#hotel">Hotel</a><a href="#facilities">Facilities</a><a href="#rooms">Rooms</a><a href="#reserve">Reserve</a></div><div class="mobile-menu-footer">VESPER HOTEL · PRIVATE NIGHT RESORT</div></div>
<header class="hero" id="top"><div class="hero-content reveal"><div class="eyebrow">PRIVATE NIGHT RESORT · EST. 1897</div><img class="hero-logo" src="./logo/vesper-logo.png" alt="VESPER"><div class="tag">A QUIET PLACE AFTER DARK</div><a class="cta" href="#hotel">ENTER THE HOTEL</a></div></header>
<section class="intro reveal" id="hotel"><div><div class="kicker">THE VESPER EXPERIENCE</div><h2>Night,<br>reimagined.</h2></div><div><p>새벽 두 시, 가장 고요한 시간에 문이 열립니다. VESPER는 밤을 살아가는 이들을 위해 설계된 프라이빗 럭셔리 리조트입니다. 오래된 귀족 저택의 절제된 우아함과 현대적인 휴양 공간이 만나, 세상과 잠시 분리된 시간을 선사합니다.</p></div></section>
<section class="hotel-image reveal"><div class="media"><img src="./images/hotel_exterior.png" alt="VESPER HOTEL exterior" loading="lazy"></div><div class="hotel-copy"><div class="kicker">THE HOUSE OF VESPER</div><h2>A private world,<br>after dark.</h2><p>도시의 소음과 빛으로부터 한 걸음 물러난 곳, VESPER의 외관은 밤의 정적을 건축으로 표현합니다. 밤이 깊어질수록 더욱 선명해지는 공간의 디테일과 절제된 조명이 VESPER만의 세계로 당신을 초대합니다.</p><div class="image-caption">VESPER HOTEL · EXTERIOR</div></div></section>
<section class="night reveal"><div class="eyebrow">A HOTEL OUTSIDE ORDINARY HOURS</div><h2>Only the night knows<br>what happens here.</h2><div class="stats"><div class="stat"><div class="num">02:00</div><div class="label">CHECK-IN</div></div><div class="stat"><div class="num">00:00</div><div class="label">CHECK-OUT</div></div><div class="stat"><div class="num">24/7</div><div class="label">GUEST INQUIRIES</div></div></div></section>
<section class="facilities reveal" id="facilities"><div class="facility-head"><div><div class="kicker">THE VESPER FACILITIES</div><h2>Beyond<br>the room.</h2></div><p>수영장부터 스파, 다이닝과 라운지까지. 객실 밖의 모든 순간도 VESPER만의 밤을 경험하도록 설계됩니다.</p></div><div class="facility-grid">
<article class="facility"><img src="./images/indoor_pool.jpg" alt="Indoor Pool" loading="lazy"><div class="facility-info"><div class="facility-no">01 · POOL</div><h3>Indoor Pool</h3><p>빛을 낮춘 실내 수영장</p></div></article>
<article class="facility"><img src="./images/outdoor_pool.jpg" alt="Outdoor Pool" loading="lazy"><div class="facility-info"><div class="facility-no">02 · POOL</div><h3>Outdoor Pool</h3><p>밤의 풍경과 이어지는 야외 수영장</p></div></article>
<article class="facility"><div class="facility-placeholder"><span>LOBBY IMAGE · TO BE ADDED</span></div><div class="facility-info"><div class="facility-no">03 · LOBBY</div><h3>The Lobby</h3><p>체크인부터 시작되는 VESPER의 첫 장면</p></div></article>
<article class="facility"><img src="./images/Vesper Spa.jpg" alt="Vesper Spa" loading="lazy"><div class="facility-info"><div class="facility-no">04 · SPA</div><h3>Vesper Spa</h3><p>밤의 리듬에 맞춘 프라이빗 케어</p></div></article>
<article class="facility"><img src="./images/private_dining.jpg" alt="Private Dining" loading="lazy"><div class="facility-info"><div class="facility-no">05 · DINING</div><h3>Private Dining</h3><p>초대받은 이들을 위한 은밀한 식사</p></div></article>
<article class="facility"><img src="./images/The Lounge.jpg" alt="The Lounge" loading="lazy"><div class="facility-info"><div class="facility-no">06 · LOUNGE</div><h3>The Lounge</h3><p>밤이 깊어질수록 조용해지는 공간</p></div></article>
<article class="facility"><img src="./images/restaurant.jpg" alt="Vesper Restaurant" loading="lazy"><div class="facility-info"><div class="facility-no">07 · RESTAURANT</div><h3>Vesper Restaurant</h3><p>밤의 시간을 위한 시그니처 다이닝</p></div></article>
</div></section>
<section class="rooms reveal" id="rooms"><div class="kicker">STAY AT VESPER</div><h2>Rooms &amp; Suites</h2><div class="room-grid"><article class="room"><img src="./images/Vesper Deluxe.jpg" alt="Vesper Deluxe" loading="lazy"><div class="room-info"><span>01 · ROOM</span><h3>Vesper Deluxe</h3><a class="room-link" href="#reserve">VIEW ROOM</a></div></article><article class="room"><img src="./images/Midnight Suite.jpg" alt="Midnight Suite" loading="lazy"><div class="room-info"><span>02 · SUITE</span><h3>Midnight Suite</h3><a class="room-link" href="#reserve">VIEW SUITE</a></div></article></div></section>
<section class="reserve reveal" id="reserve"><div><div class="kicker">PRIVATE RESERVATIONS</div><h2>Stay after<br>dark.</h2><p>VESPER의 모든 객실은 제한된 시간과 초대된 투숙객을 위해 준비됩니다. 밤이 시작되는 시간, 당신만을 위한 가장 조용한 체크인을 경험해보세요.</p></div><div class="reserve-box"><small>RESERVATION DESK</small><strong>24-HOUR INQUIRIES</strong><a href="mailto:reservations@vesper.hotel">REQUEST A RESERVATION</a></div></section>
<footer><div>VESPER HOTEL</div><div>PRIVATE RESERVATIONS · BY INVITATION</div></footer>
</div>
<script>
(function(){
 const nav=document.getElementById('nav');
 const menu=document.getElementById('mobileMenu');
 const open=document.getElementById('menuOpen');
 const close=document.getElementById('menuClose');
 const links=menu.querySelectorAll('a');
 function setMenu(isOpen){menu.classList.toggle('open',isOpen);document.body.classList.toggle('menu-open',isOpen);open.setAttribute('aria-expanded',String(isOpen));menu.setAttribute('aria-hidden',String(!isOpen));}
 open.addEventListener('click',()=>setMenu(true));
 close.addEventListener('click',()=>setMenu(false));
 links.forEach(link=>link.addEventListener('click',()=>setMenu(false)));
 document.addEventListener('keydown',e=>{if(e.key==='Escape')setMenu(false)});
 window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',window.scrollY>30),{passive:true});
 const io=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('visible')}),{threshold:.08});
 document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
})();
</script>
</body>
</html>
